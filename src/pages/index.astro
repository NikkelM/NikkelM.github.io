			name="description"
			content="nikkelm.dev is being rebuilt. A new home for the projects, writing and work of Nikkel Mollenhauer, a software and site reliability engineer, is on the way."
		/>
		<link rel="canonical" href="https://nikkelm.dev/" />

		<meta property="og:type" content="website" />
